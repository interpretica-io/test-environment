#
# Engine on the build host and a Test Agent for 64-bit Windows built by
# MinGW-w64. The agent is started by rcfunix with the "windows" element
# of its RCF configuration.

TE_TOOLS([rgt trc])

TE_PLATFORM([], [], [-D_GNU_SOURCE], [], [],
            [logger_core tools logic_expr conf_oid rpcxdr rpc_types \
             ipc bsapi loggerten rcfapi confapi comm_net_engine rcfunix \
             tapi rcfrpc trc log_proc asn ndn])

TE_PLATFORM([win64], [--host=x86_64-w64-mingw32], [], [], [],
            [logger_core tools conf_oid asn ndn rpcxdr rpc_types \
             comm_net_agent loggerta rpctransport agentlib \
             rpcserver rcfpch tad])

# The agent has no TAD on Windows: the dummy callbacks only
TE_LIB_PARMS([tad], [win64], [], [--without-tad])

TE_TA_TYPE([win64], [win64], [win32], [], [], [], [], [])
