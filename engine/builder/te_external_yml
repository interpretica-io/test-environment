# Test Environment Builder
#
# Convert an external libraries catalog (YAML) into shell declarations
# consumed by the Builder (see TE_EXT_REPO_USE in builder.m4 and
# te_fetch_ext_repos).
#
# Catalog format:
#
#     repositories:
#       - name: tsf_wifi
#         url: https://example.com/tsf-wifi.git
#         ref: v1.0.0
#         libs:
#           - tapi_cfg_wifi
#           - ta_wifi
#
# 'libs' may be omitted: the Builder then treats the repository root
# as one library named after the repository.
#
# The parser below understands the block subset shown above and
# rejects the rest, so that a catalog reads the same way here and in
# a full YAML reader, and TE builds without a YAML library. Flow
# collections, anchors, tags, block scalars and multiple documents
# are errors.
#
# Usage: te_external_yml <catalog.yml> [...]

import re
import shlex
import sys

NAME_RE = re.compile(r'^[A-Za-z][A-Za-z0-9_]*$')
KNOWN_KEYS = {'name', 'url', 'ref', 'libs'}
LIST_KEYS = {'libs'}
# In YAML a '#' starts a comment only at the beginning of a line or
# after a space; elsewhere it is an ordinary character, e.g. in
# 'url: https://example.com/x.git#frag'
COMMENT_RE = re.compile(r'(?:^|\s)#')


def error(msg):
    sys.stderr.write('ERROR: %s\n' % msg)
    sys.exit(1)


# Constructs of the full language that the subset does not cover.
# Refuse them; a misreading would be worse.
UNSUPPORTED = (
    ('\t', 'a tab (indent with spaces)'),
    ('&', 'an anchor'),
    ('*', 'an alias'),
    ('!', 'a tag'),
)


def reject_unsupported(line, loc):
    stripped = line.strip()
    if stripped in ('---', '...'):
        error('%s: this parser reads one document only' % loc)
    for char, what in UNSUPPORTED:
        if char in line:
            error('%s: this parser does not support %s' % (loc, what))
    value = stripped.partition(':')[2].strip() if ':' in stripped else ''
    if value[:1] in ('[', '{'):
        error('%s: this parser does not support flow collections; use '
              'a block sequence' % loc)
    if value in ('|', '>') or value[:2] in ('|-', '>-', '|+', '>+'):
        error('%s: this parser does not support block scalars' % loc)


def strip_comment(raw):
    """Cut a trailing comment off a line the way YAML does."""
    match = COMMENT_RE.search(raw)
    if match:
        raw = raw[:match.start()]
    return raw.rstrip()


def parse_catalog(path):
    """Parse the documented catalog subset into a list of repositories."""
    repos = []
    repo = None
    cur_list = None

    with open(path) as f:
        for lineno, raw in enumerate(f, 1):
            line = strip_comment(raw)
            if not line.strip():
                continue
            loc = '%s:%d' % (path, lineno)
            reject_unsupported(line, loc)
            stripped = line.strip()
            indent = len(line) - len(line.lstrip())

            if indent == 0:
                if stripped == 'repositories:':
                    continue
                error('%s: unexpected top-level entry %r; "repositories:" '
                      'is the only one allowed' % (loc, stripped))

            if stripped.startswith('- ') or stripped == '-':
                item = stripped[1:].strip()
                if cur_list is not None and ':' not in item:
                    repo[cur_list].append(unquote(item))
                    continue
                # New repository entry
                cur_list = None
                repo = {}
                repos.append(repo)
                if item:
                    key, value = split_kv(item, loc)
                    repo[key] = value
                continue

            if repo is None:
                error('%s: mapping entry outside of a repository item'
                      % loc)

            key, value = split_kv(stripped, loc)
            if key in LIST_KEYS:
                if value:
                    error('%s: "%s" must be a list' % (loc, key))
                repo[key] = []
                cur_list = key
            else:
                cur_list = None
                repo[key] = value

    return repos


def split_kv(s, loc):
    if ':' not in s:
        error('%s: expected "key: value", got %r' % (loc, s))
    key, _, value = s.partition(':')
    return key.strip(), unquote(value.strip())


def unquote(s):
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ('"', "'"):
        return s[1:-1]
    return s


def process(path):
    # The parser guarantees the shape: a repository is a mapping of
    # strings, and a list key holds a list. Check the content only.
    for repo in parse_catalog(path):
        unknown = set(repo) - KNOWN_KEYS
        if unknown:
            error('%s: unknown repository keys: %s'
                  % (path, ', '.join(sorted(unknown))))

        name = repo.get('name')
        url = repo.get('url')
        ref = repo.get('ref')
        libs = repo.get('libs', [])

        if not name or not NAME_RE.match(name):
            error('%s: bad repository name %r' % (path, name))
        if not url:
            error('%s: repository %s: "url" is mandatory' % (path, name))
        if not ref:
            error('%s: repository %s: "ref" is mandatory' % (path, name))
        for lib in libs:
            if not NAME_RE.match(lib):
                error('%s: repository %s: bad library name %r'
                      % (path, name, lib))

        # Guard against another catalog that declares the same
        # repository differently. Compare each part of the
        # declaration: otherwise the order of the --external options
        # would pick the winner among conflicting refs or library
        # lists. The Builder sources the generated code inside a
        # dummy loop, so 'break' reports a configuration error, as
        # the builder.m4 macros do.
        emit_var(name, 'URL', 'URL', url)
        emit_var(name, 'REF', 'ref', ref)
        emit_var(name, 'LIBS', 'list of libraries', ' '.join(libs))


def emit_var(name, suffix, what, value):
    """Emit a guarded assignment of one part of a repository declaration."""
    var = 'TE_BS_EXT_REPO_%s_%s' % (name, suffix)

    # ${var+set} rather than -n: an empty list is a declaration too,
    # and conflicts with a non-empty one
    print('if [[ -n "${%s+set}" && "${%s}" != %s ]] ; then'
          % (var, var, shlex.quote(value)))
    print('    TE_BS_CONF_ERR=%s ;'
          % shlex.quote('external repo %s is already declared with '
                        'a different %s' % (name, what)))
    print('    break ;')
    print('fi')
    print('%s=%s' % (var, shlex.quote(value)))


def main():
    if len(sys.argv) < 2:
        error('Usage: %s <catalog.yml> [...]' % sys.argv[0])
    for path in sys.argv[1:]:
        process(path)


if __name__ == '__main__':
    main()
