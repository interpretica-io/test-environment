//
// Build Test Environment and run its selftest suite.
//
// The stages are the same as they always were. What used to be written
// into the job is a parameter now, so that the very same job serves a
// lab and a machine which has nothing but Docker:
//
//  - 'ts_cfg' is the configuration to build and run for;
//  - 'buildOnlyLabel' is the label of the nodes which build in
//    addition, and no such node is required any more;
//  - 'mail_to' is where the reports go.
//
// Keeping the parameters as they are reproduces the previous
// behaviour.
//
// Required plugins:
//  - Docker Pipeline
//  - Email Extension Plugin (if want to send reports)
//  - JUnit
//  - Pipeline: Stage Step
//  - Timestamper
//  - Warnings Next Generation

pipeline {
    options {
        buildDiscarder(logRotator(numToKeepStr:'14'))
        //
        // TE_BASE below points into te/, so the checkout has to go
        // there. jenkins/pipelines/te-doc does the same.
        //
        checkoutToSubdirectory('te')
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string defaultValue: 'gimli1',
               description: 'Configuration to build and run the suite for',
               name: 'ts_cfg', trim: true
        string defaultValue: 'te-build-only',
               description: 'Label for run build only job',
               name: 'buildOnlyLabel', trim: false
        string defaultValue: '',
               description: 'E-Mail addresses where to send reports',
               name: 'mail_to', trim: true
        string defaultValue: '',
               description: 'Label of the node to build on; ' +
                            'empty for any node which can run Docker',
               name: 'buildLabel', trim: true
    }

    //
    // The build environment is the image described by the Dockerfile
    // next to this file, so that the job needs no node prepared by
    // hand, only one which can run Docker. 'buildLabel' pins it to
    // particular nodes where that matters.
    //
    // A Test Agent reads and writes /proc/sys, which a container gets
    // read-only by default: without --privileged the Configurator
    // fails to start on the very first object.
    //
    agent {
        dockerfile {
            dir 'te/suites/selftest/cbs'
            args '--privileged'
            label "${params.buildLabel}"
        }
    }

    triggers {
        cron('@daily')
    }

    environment {
        TE_BASE = "${env.WORKSPACE}/te"
        TE_BUILD = "${env.WORKSPACE}/te-build"
        TE_INSTALL = "${env.WORKSPACE}/te-build/inst"
        TS_TOPDIR = "${env.WORKSPACE}/te/suites/selftest"
        TS_RUNDIR = "${env.WORKSPACE}/te-selftest-run"
    }

    stages {
        stage("Build") {
            steps {
                script {
                    lastStage = env.STAGE_NAME
                }
                dir("$TS_RUNDIR") {
                    sh '${TS_TOPDIR}/run.sh --cfg=${ts_cfg} --build-only'
                }
            }
        }
        stage("Build on various platforms") {
            steps {
                script {
                    def builders = [:]
                    def nodes = getNodes(params.buildOnlyLabel)

                    //
                    // Where no node carries the label, there is
                    // nothing to build on: parallel() of an empty map
                    // is an error, so say so and go on.
                    //
                    if (nodes.isEmpty()) {
                        echo "No node is labelled '${params.buildOnlyLabel}'"
                        return
                    }

                    for (p in nodes) {
                        def platform = p
                        builders[platform] = {
                            node(platform) {
                                checkout scm
                                withEnv(["TE_BASE=${env.WORKSPACE}/te",
                                         "TE_BUILD=${env.WORKSPACE}/te-build",
                                         "TE_INSTALL=${env.WORKSPACE}/te-build/inst",
                                         "TS_TOPDIR=${env.WORKSPACE}/te/suites/selftest",
                                         "TS_RUNDIR=${env.WORKSPACE}/te-selftest-run"])
                                {
                                    dir("$TS_RUNDIR") {
                                        try {
                                            sh '${TS_TOPDIR}/run.sh --cfg=localhost --build-only'
                                        }
                                        catch (error) {
                                            unstable("Build failed")
                                            currentBuild.result = 'FAILURE'
                                        }
                                    }
                                }
                            }
                        }
                    }
                    parallel builders
                }
            }
        }
        stage("Analyze Build") {
            steps {
                recordIssues tools: [gcc()]
            }
        }
        stage("Run") {
            steps {
                script {
                    lastStage = env.STAGE_NAME
                }
                dir ("$TS_RUNDIR") {
                    sh 'rm -fr * || true'
                    sh '''${TS_TOPDIR}/run.sh -n --log-junit=junit.log \
                              --tester-req=\\!BROKEN                   \
                              --cfg=${ts_cfg}
                    '''
                }
            }
        }
        stage("Report") {
            steps {
                script {
                    lastStage = env.STAGE_NAME
                }
                dir ("$TS_RUNDIR") {
                    archiveArtifacts artifacts: 'tmp_raw_log'
                    archiveArtifacts artifacts: 'log.txt'
                    junit 'junit.log'
                }
            }
        }
    }

    post {
        unsuccessful {
            script {
                if (params.mail_to != '') {
                    emailext (
                        to: params.mail_to,
                        recipientProviders: [requestor(), culprits()],
                        subject: "[CI TE] ${env.JOB_NAME} job ${env.BUILD_NUMBER} unsuccessful",
                        body: "Check console output at: ${env.BUILD_URL}, failure step $lastStage",
                    )
                }
            }
        }
        success {
            script {
                if (params.mail_to != '') {
                    emailext (
                        to: params.mail_to,
                        recipientProviders: [requestor()],
                        subject: "[CI TE] ${env.JOB_NAME} job ${env.BUILD_NUMBER} success",
                        body: "Check console output at: ${env.BUILD_URL}",
                    )
                }
            }
        }
        fixed {
            script {
                if (params.mail_to != '') {
                    emailext (
                        to: params.mail_to,
                        recipientProviders: [requestor(), culprits()],
                        subject: "[CI TE] ${env.JOB_NAME} job ${env.BUILD_NUMBER} fixed",
                        body: "Check console output at: ${env.BUILD_URL}",
                    )
                }
            }
        }
    }
}

@NonCPS
def getNodes(String label) {
    def nodes = jenkins.model.Jenkins.instance.nodes
    def filteredNodes = nodes.findAll { node ->
        node.labelString.contains("${label}")
    }
    return filteredNodes.collect { node ->
        node.name
    }
}
